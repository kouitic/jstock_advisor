# LINE Messaging API 認証情報(要求仕様16節・21節)。
# このファイルをコピーして .env を作成し、実際の値を設定してください。
#   cp .env.example .env   (PowerShellの場合: Copy-Item .env.example .env)
# .env はローカル専用の秘密情報のため .gitignore により追跡対象外です。
# どちらも未設定の場合、LINE通知は標準出力へのドライラン表示のみになります。

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# LINE Webhook(チャット起点の売買記録・ウォッチリスト登録)用。
# LINE Developersコンソールの「チャネル基本設定」にある「チャネルシークレット」。
# LINE_CHANNEL_ACCESS_TOKENとは別の値なので注意。未設定の場合、Webhookは署名検証に
# 失敗するため全リクエストを拒否する(ローカルCLI利用のみなら未設定で問題ない)。
LINE_CHANNEL_SECRET=

# EDINET API v2 認証情報(要求仕様13節・21節)。https://api.edinet-fsa.go.jp/ で無料登録して取得。
EDINET_API_KEY=
